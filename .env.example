# ===============================================
# DCCALOR - Variáveis de Ambiente de Produção
# ===============================================

# Porta onde o servidor Node.js irá escutar (padrão: 3000)
PORT=3000

# Chave de API do Google Gemini (necessária para os relatórios climáticos com IA)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# URL base da aplicação na VM (ex: http://IP_DA_VM:3000 ou https://dccalor.fortaleza.ce.gov.br)
APP_URL="http://localhost:3000"

# Credenciais para integração em tempo real com as 11 estações da Defesa Civil (Plugfield)
PLUGFIELD_USERNAME="elineldo.pinheiro@sesec.fortaleza.ce.gov.br"
PLUGFIELD_PASSWORD="sua_senha_aqui"
PLUGFIELD_API_KEY="sua_api_key_aqui"
